# Gully Bridge, Gully Chain Testnet build. Public values only: never put a secret in this file.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time (gully/Dockerfile reads this file).

# Free public RPCs for the parent/default chains (no provider keys).
NEXT_PUBLIC_RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL_ARBITRUM_ONE=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_ARBITRUM_NOVA=https://nova.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_BASE=https://mainnet.base.org
NEXT_PUBLIC_RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Same optimisation flags as upstream's .env.local.sample
NEXT_PUBLIC_PROVIDER_CACHE_TX_RECEIPTS=mainnet,testnet
NEXT_PUBLIC_PROVIDER_BATCH_RPC=testnet
NEXT_PUBLIC_PROVIDER_CACHE_EVENT_LOGS=testnet

# Left empty on purpose: without a WalletConnect Cloud project id the app offers browser (injected) wallets only.
# Pass a real id as a build arg (WALLETCONNECT_PROJECT_ID) from the box, never commit it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# `/` with no chain params opens Arbitrum Sepolia -> Gully Chain Testnet (packages/app/next.config.js)
GULLY_DEFAULT_QUERY="sourceChain=arbitrum-sepolia&destinationChain=gully-chain-testnet"
